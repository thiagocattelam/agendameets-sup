// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  GESTAO
  ATENDENTE
}

model Usuario{
  id String @id @default(cuid())
  nome String
  ativo Boolean @default(true)
  email String? @unique
  alertaMinutos Int? @default(30)
  createdAt DateTime @default(now())
  agendamentos Agendamento[]

  perfil Perfil @default(ATENDENTE)
  permissoes UsuarioPermissao[]

  googleCalendarConectado Boolean @default(false)
  googleCredencial GoogleCredencial?
}

model UsuarioPermissao{
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  permissao String
  concedida Boolean @default(true)

  @@id([usuarioId, permissao])
}

model GoogleCredencial{
  id String @id @default(cuid())
  accessToken String?
  refreshToken String?
  tokenExpiry DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String @unique
}
model Agendamento{
  id String @id @default(cuid())
  dataHoraInicio DateTime
  dataHoraFim DateTime
  cliente String
  linkChat String?
  observacoes String?
  alertaMinutos Int?
  googleEventId String?
  linkMeet String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atendente Usuario @relation(fields: [atendenteId], references: [id])
  atendenteId String

  assuntos Assunto[]

  status Status @relation(fields: [statusId], references: [id])
  statusId String
}
model Assunto{
  id String @id @default(cuid())
  descricao String
  agendamentos Agendamento[]
}

model Status{
  id String @id @default(cuid())
  descricao String
  corHex String // ex: "#22c55e" para colorir o badge na lista
  agendamentos Agendamento[]
}

